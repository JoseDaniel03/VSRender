# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Ignore build artifacts and unreviewed third-party binary dependencies.
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Only the seven pinned original VSRender compilation dependencies are allowed.
# GitHub Actions checks each Git blob SHA before compiling.
/libs/*.jar
!/libs/AxiomPaperPlugin-5.0.4.jar
!/libs/denizen-1.3.3.jar
!/libs/jni-internal-lookup-1.9.jar
!/libs/leafpile-1.0.0.1.jar
!/libs/worldguard-bukkit-7.0.14-dist.jar
/bukkit/compatibility/legacy/libs/*.jar
!/bukkit/compatibility/legacy/libs/awsm-api.jar
!/bukkit/compatibility/legacy/libs/flow-nbt-2.0.2.jar
/_private_build_libraries/

# Original verified Gradle wrapper also stays tracked.
!/gradle/wrapper/gradle-wrapper.jar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

build/
.gradle/
.idea/
.codex*/
.vscode/settings.json
/runPaper/
/runFolia/
/server/
/buildSrc/.kotlin/
/target
