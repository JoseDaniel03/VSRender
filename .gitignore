# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package files. Third-party build dependencies must never be committed
# to this public repository; CI restores them temporarily from upstream.
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Explicitly protect the private dependency staging paths.
/libs/*.jar
/bukkit/compatibility/legacy/libs/*.jar
/_private_build_libraries/

# The verified Gradle wrapper is the sole intentional tracked JAR exception.
!/gradle/wrapper/gradle-wrapper.jar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

build/
.gradle/
.idea/
.codex*/
.vscode/settings.json
/runPaper/
/runFolia/
/server/
/buildSrc/.kotlin/
/target
